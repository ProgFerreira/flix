generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
}

enum UserPlan {
  free
  premium
  pro
}

enum UserStatus {
  active
  blocked
}

enum BillingCycle {
  monthly
  annual
}

enum SubscriptionStatus {
  active
  overdue
  cancelled
  expired
}

enum PaymentMethod {
  pix
  card
  boleto
  manual
}

enum VideoSource {
  youtube
  upload
  article
}

enum VideoStatus {
  processing
  ready
  error
}

enum SharePermission {
  view
  edit
}

enum CollectionRole {
  owner
  editor
  viewer
}

enum PlanChangeRequestStatus {
  pending
  approved
  rejected
  cancelled
}

enum BillingReminderType {
  upcoming
  overdue
}

// Uma conta = um espectador. Não há perfis (Netflix-style) de propósito:
// o produto é clube de criador único, não assinatura familiar compartilhada.
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  phone     String?  @db.VarChar(20)
  password  String
  createdAt DateTime @default(now())
  emailVerifiedAt DateTime?

  role      UserRole   @default(user)
  plan      UserPlan   @default(free)
  status    UserStatus @default(active)
  deletadoEm DateTime?
  criadoPorId Int?

  videos            Video[]
  categories        Category[]
  collections       Collection[]
  collectionMembers CollectionMember[]
  sharesGiven       VideoShare[]       @relation("ShareFrom")
  sharesReceived    VideoShare[]       @relation("ShareTo")
  payments          PlanPayment[]
  subscription      Subscription?
  planChangeRequests PlanChangeRequest[]
  reviewedPlanChanges PlanChangeRequest[] @relation("PlanChangeReviewer")
  favorites         Favorite[]
  watchProgress     WatchProgress[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  auditLogs           AdminAuditLog[]
  accessGrantsReceived VideoAccessGrant[] @relation("GrantTo")
  accessGrantsGiven    VideoAccessGrant[] @relation("GrantBy")
  consentimentos       ConsentimentoLgpd[]
  criadoPor            User?  @relation("UserCreatedBy", fields: [criadoPorId], references: [id], onDelete: SetNull)
  contasCriadas        User[] @relation("UserCreatedBy")
  pagamentosRegistrados PlanPayment[] @relation("PaymentCreatedBy")

  @@index([deletadoEm])
  @@index([criadoPorId])
}

// Token de confirmação de e-mail. Mesma ideia do reset de senha: o token cru
// vai no link; o banco guarda só o SHA-256. Contas antigas recebem
// emailVerifiedAt = createdAt na migration pra não ficarem trancadas.
model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

// Token de recuperação de senha. Guarda só o hash (SHA-256) do token que vai
// por e-mail — se o banco vazar, ninguém consegue usar as linhas daqui pra
// resetar senha de ninguém, porque o token cru nunca fica gravado.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

// Favorito por usuário — tabela própria porque Video.favorite é por linha do
// vídeo (certo pra biblioteca pessoal, onde cada vídeo pertence a um usuário
// só). Um vídeo de catálogo é uma linha vista por muitos assinantes; se
// "favoritar" usasse Video.favorite, o favorito de um vazaria pra todo mundo.
model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  videoId   Int
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

// Posição de reprodução por usuário — mesma razão do Favorite acima: precisa
// ser por (usuário, vídeo), não um campo único no Video.
model WatchProgress {
  id        Int      @id @default(autoincrement())
  userId    Int
  videoId   Int
  seconds   Int      @default(0)
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

model Subscription {
  id              Int                @id @default(autoincrement())
  userId          Int                @unique
  plan            UserPlan
  billing         BillingCycle
  amount          Decimal            @db.Decimal(10, 2)
  startDate       DateTime           @default(now())
  nextBillingDate DateTime
  status          SubscriptionStatus @default(active)
  cancelledAt      DateTime?
  lastReminderType BillingReminderType?
  lastReminderAt   DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments PlanPayment[]

  @@index([status, nextBillingDate])
}

// Pedido de troca de plano feito pelo cliente. Só vira plano ativo depois
// que a gestão aprova (e, em upgrade pago, registra o pagamento).
model PlanChangeRequest {
  id         Int                     @id @default(autoincrement())
  userId     Int
  fromPlan   UserPlan
  toPlan     UserPlan
  billing    BillingCycle            @default(monthly)
  amount     Decimal                 @db.Decimal(10, 2)
  note       String?
  status     PlanChangeRequestStatus @default(pending)
  reviewedBy Int?
  reviewedAt DateTime?
  receiptPath String?
  receiptMimeType String?
  receiptSize Int?
  reviewNote String?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("PlanChangeReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, status])
}

model PlanPayment {
  id              Int            @id @default(autoincrement())
  userId          Int
  subscriptionId  Int?
  plan            UserPlan
  billing         BillingCycle   @default(monthly)
  amount          Decimal        @db.Decimal(10, 2)
  method          PaymentMethod  @default(manual)
  note            String?
  idempotencyKey  String?        @unique
  receiptPath     String?
  receiptMimeType String?
  receiptSize     Int?
  createdAt       DateTime       @default(now())
  criadoPorId     Int?

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  criadoPor    User?         @relation("PaymentCreatedBy", fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

// Aceite de termos/privacidade (LGPD): data, IP e versão do documento.
model ConsentimentoLgpd {
  id       Int      @id @default(autoincrement())
  userId   Int
  tipo     String
  aceito   Boolean
  versao   String
  ip       String?
  criadoEm DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tipo])
}

model AdminAuditLog {
  id         Int      @id @default(autoincrement())
  adminId    Int?
  action     String
  targetType String
  targetId   Int?
  meta       String?  @db.Text
  createdAt  DateTime @default(now())

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([adminId, createdAt])
  @@index([targetType, targetId])
}

model Category {
  id              Int             @id @default(autoincrement())
  userId          Int
  name            String
  color           String          @default("#e85d04")
  createdAt       DateTime        @default(now())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoCategories VideoCategory[]

  @@unique([userId, name])
}

model Video {
  id              Int             @id @default(autoincrement())
  userId          Int
  url             String?
  videoId         String?
  title           String
  thumbnail       String
  duration        String?
  channelName     String?
  watched         Boolean         @default(false)
  watchedAt       DateTime?
  favorite        Boolean         @default(false)
  notes           String?         @db.Text
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())

  source          VideoSource     @default(youtube)
  filePath        String?
  mimeType        String?
  fileSize        BigInt?
  status          VideoStatus     @default(ready)
  published       Boolean         @default(false)
  requiredPlan    UserPlan        @default(free)

  // Derivados do FFmpeg (só source=upload). O original fica em filePath;
  // playbackPath é MP4 H.264 quando o arquivo enviado não toca no browser
  // (ex.: .mov); previewPath é a variante ~480p; thumbPath é o JPEG do frame.
  previewPath           String?
  playbackPath          String?
  thumbPath             String?
  processingStartedAt   DateTime?
  processError          String?   @db.VarChar(500)

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoCategories VideoCategory[]
  shares          VideoShare[]
  collectionVideos CollectionVideo[]
  favoritedBy     Favorite[]
  watchProgress   WatchProgress[]
  accessGrants    VideoAccessGrant[]
  courseLesson    CourseLesson?

  @@index([userId, createdAt])
  @@index([userId, sortOrder])
  @@index([userId, videoId])
  @@index([source, published, status])
  @@index([status, processingStartedAt])
}

model VideoCategory {
  videoId    Int
  categoryId Int
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([videoId, categoryId])
}

model VideoShare {
  id         Int             @id @default(autoincrement())
  videoId    Int
  fromUserId Int
  toUserId   Int
  permission SharePermission @default(view)
  createdAt  DateTime        @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  from  User  @relation("ShareFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to    User  @relation("ShareTo",   fields: [toUserId],   onDelete: Cascade, references: [id])

  @@unique([videoId, toUserId])
}

// Exceção de acesso no catálogo: o plano mínimo continua valendo pra todo
// mundo; esta tabela só libera pessoas específicas (presente, beta, cliente).
// Não mistura com VideoShare, que é colaboração da biblioteca pessoal.
model VideoAccessGrant {
  videoId   Int
  userId    Int
  grantedBy Int?
  createdAt DateTime @default(now())

  video   Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user    User  @relation("GrantTo", fields: [userId], references: [id], onDelete: Cascade)
  granter User? @relation("GrantBy", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@id([videoId, userId])
  @@index([userId])
}

model Collection {
  id         Int      @id @default(autoincrement())
  name       String
  ownerId    Int
  createdAt  DateTime @default(now())
  isPublic   Boolean  @default(false)
  shareToken String?  @unique @db.VarChar(64)

  owner   User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members CollectionMember[]
  videos  CollectionVideo[]
}

model CollectionMember {
  collectionId Int
  userId       Int
  role         CollectionRole @default(viewer)
  joinedAt     DateTime       @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([collectionId, userId])
}

model CollectionVideo {
  collectionId Int
  videoId      Int
  addedBy      Int
  addedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  video      Video      @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([collectionId, videoId])
}

// Trilha didática do catálogo. A aula continua sendo Video; o curso só
// agrupa e ordena. Apagar o curso não apaga o arquivo — só a trilha.
model Course {
  id           Int      @id @default(autoincrement())
  title        String
  slug         String   @unique
  description  String?  @db.Text
  thumbnail    String?  @db.VarChar(500)
  learnings    String?  @db.Text
  requiredPlan UserPlan @default(free)
  published    Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  modules CourseModule[]

  @@index([published, sortOrder])
}

model CourseModule {
  id        Int    @id @default(autoincrement())
  courseId  Int
  title     String
  sortOrder Int    @default(0)

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons CourseLesson[]

  @@index([courseId, sortOrder])
}

model CourseLesson {
  id        Int @id @default(autoincrement())
  moduleId  Int
  videoId   Int @unique
  sortOrder Int @default(0)

  module CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  video  Video        @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([moduleId, sortOrder])
}

// Contador compartilhado entre instâncias e restarts (substitui o Map em memória).
model RateLimitBucket {
  chave   String   @id @db.VarChar(191)
  count   Int
  resetAt DateTime

  @@index([resetAt])
}
