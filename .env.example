DATABASE_URL="mysql://root:@localhost:3306/flix"
NEXTAUTH_SECRET="troque-por-uma-chave-aleatoria"
NEXTAUTH_URL="http://localhost:3003"

# Recuperação de senha (lib/email.ts, via Resend — resend.com)
# Sem RESEND_API_KEY, o link de reset é só logado no console em dev, nenhum
# e-mail é enviado de verdade.
RESEND_API_KEY=""
EMAIL_FROM="Flix <onboarding@resend.dev>"

# Job diário de vencimento/lembretes: POST /api/cron/billing
# Fila de vídeo (miniatura + 480p): POST /api/cron/process-videos
# Authorization: Bearer <CRON_SECRET>
# Gere um valor longo (ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Sem este valor o endpoint recusa qualquer chamada. Agende o disparo no Windows:
#   powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-billing-cron.ps1
CRON_SECRET=""

# FFmpeg — gera miniatura real e variante 480p após o upload.
# No Windows/WAMP: instale https://www.gyan.dev/ffmpeg/builds/ (essentials)
# e aponte os executáveis, ou deixe em branco se ffmpeg/ffprobe estiverem no PATH.
# FFMPEG_PATH="C:\\ffmpeg\\bin\\ffmpeg.exe"
# FFPROBE_PATH="C:\\ffmpeg\\bin\\ffprobe.exe"
FFMPEG_PATH=""
FFPROBE_PATH=""

# Obrigatório definir explicitamente. Em produção atrás de Apache/WAMP/nginx/CDN
# use "true" — senão o rate limit de login/cadastro vira um balde global (todas
# as requisições caem no IP "unknown"). Só use "false" se o Node receber o HTTP
# direto, sem proxy. O servidor avisa no console se a variável faltar.
TRUST_PROXY="false"

# Chave PIX e e-mail de suporte exibidos na vitrine e em /plano (prefixo
# NEXT_PUBLIC_ porque a UI do cliente precisa ler).
NEXT_PUBLIC_PIX_KEY="contato@geflix.app"
NEXT_PUBLIC_SUPPORT_EMAIL="suporte@geflix.app"
